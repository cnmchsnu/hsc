{
    "name": "@repo/commerce",
    "private": true,
    "dependencies": {
        "@repo/database": "workspace:*",
        "@supabase/postgrest-js": "^2.109.0",
        "@supabase/supabase-js": "^2.108.2"
    },
    "exports": {
        ".": "./src/index.ts",
        "./types": {
            "types": "./src/types/index.ts"
        },
        "./product": {
            "default": "./src/product/index.ts",
            "types": "./src/product/types.ts",
            "imports": "./src/product/index.ts"
        },
        "./category": {
            "default": "./src/category/index.ts",
            "types": "./src/category/types.ts",
            "imports": "./src/category/index.ts"
        },
        "./product-image": {
            "default": "./src/product-image/index.ts",
            "types": "./src/product-image/types.ts",
            "imports": "./src/product-image/index.ts"
        },
        "./product-category": {
            "default": "./src/product-category/index.ts",
            "types": "./src/product-category/types.ts",
            "imports": "./src/product-category/index.ts"
        },
        "./server": "./src/server/index.ts"
    }
}